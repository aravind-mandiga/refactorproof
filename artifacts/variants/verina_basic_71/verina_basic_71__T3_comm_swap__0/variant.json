 "transformed_code": "  let minLength := Nat.min str1.length str2.length\n  let rec aux (idx : Nat) (acc : List Char) : List Char :=\n    if idx < minLength then\n      match str1[idx]?, str2[idx]? with\n      | some c1, some c2 =>\n          if c1 ≠ c2 then acc\n          else aux (1 + idx) (acc ++ [c1])\n      | _, _ => acc\n    else acc\n  aux 0 []\n",
