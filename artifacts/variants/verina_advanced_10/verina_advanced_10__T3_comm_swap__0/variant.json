 "transformed_code": "  let rec countFactors (n : Nat) (primes : List Nat) : List (Nat × Nat) :=\n    match primes with\n    | [] => []\n    | p :: ps =>\n      let (count, n') :=\n        countFactor n p 0\n      (p, count) :: countFactors n' ps\n\n  countFactors n primes\n  where\n\n  countFactor : Nat → Nat → Nat → Nat × Nat\n  | 0, _, count =>\n    (count, 0)\n  | n, p, count =>\n    if h : n > 0 ∧ p > 1 then\n      have : n / p < n :=\n        Nat.div_lt_self h.1 h.2\n      if n % p == 0 then\n        countFactor (n / p) p (1 + count)\n      else\n        (count, n)\n    else\n      (count, n)\n  termination_by n _ _ => n\n",
