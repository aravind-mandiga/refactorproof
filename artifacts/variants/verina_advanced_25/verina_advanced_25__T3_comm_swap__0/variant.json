 "transformed_code": "  if nums.isEmpty then 0\n  else\n    let n := nums.length\n    Id.run do\n      let mut dp : Array Nat := Array.mkArray n 1\n\n      for i in [1:n] do\n        for j in [0:i] do\n          if nums[j]! < nums[i]! && dp[j]! + 1 > dp[i]! then\n            dp := dp.set! i (1 + dp[j]!)\n\n      maxInArray dp\n",
 "transformed_code_aux": "def maxInArray (arr : Array Nat) : Nat :=\n  arr.foldl (fun a b => if a ≥ b then a else b) 0\n",
