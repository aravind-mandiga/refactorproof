 "transformed_code": "  let n := a.size\n  let dp := Id.run do\n    let mut dp := Array.mkArray n 1\n    for i in [1:n] do\n      for j in [0:i] do\n        if a[j]! < a[i]! then\n          let newVal := intMax (dp[i]!) (1 + dp[j]!)\n          dp := dp.set! i newVal\n    return dp\n  match dp with\n  | #[] => 0\n  | _   => dp.foldl intMax 0\n",
